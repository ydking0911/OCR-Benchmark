# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

UPSTAGE_API_KEY=up_xxxxxxxxxxxxxxxxxxxxxxxx

# NCP CLOVA OCR General API. The invoke URL is per-account and is shown in the
# NCP console under CLOVA OCR > Domain > APIGW Invoke URL.
NCP_CLOVA_OCR_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NCP_CLOVA_OCR_INVOKE_URL=https://xxxxxxxx.apigw.ntruss.com/custom/v1/00000/xxxxxxxxxxxx/general
